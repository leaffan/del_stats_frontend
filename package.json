{
    "name": "del_stats_frontend",
    "version": "1.0.0",
    "description": "Public frontend for DEL hockey statistics. Contains a static AngularJS frontend for presenting player, team, and career data.",
    "private": true,
    "scripts": {
        "format": "prettier --write README.md CONTRIBUTING.md package.json .prettierrc.json .github/workflows/ci.yml .github/dependabot.yml eslint.config.js",
        "format:check": "prettier --check README.md CONTRIBUTING.md package.json .prettierrc.json .github/workflows/ci.yml .github/dependabot.yml eslint.config.js",
        "validate:routes": "node scripts/validate-routes.js",
        "lint": "eslint .",
        "harvest-fixture": "node scripts/build-test-fixture.js",
        "verify:fixture": "node scripts/verify-fixture.js",
        "vendor": "node scripts/vendor.js",
        "verify:vendor": "node scripts/vendor.js --check",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "check": "pnpm run format:check && pnpm run validate:routes && pnpm run verify:vendor",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{md,json,yml,yaml}": "prettier --write",
        "*.js": "prettier --write"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leaffan/del_stats_frontend.git"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/leaffan/del_stats_frontend/issues"
    },
    "homepage": "https://github.com/leaffan/del_stats_frontend#readme",
    "dependencies": {
        "@fortawesome/fontawesome-free": "6.7.2",
        "angular": "1.8.3",
        "angular-moment": "1.3.0",
        "angular-moment-picker": "0.10.2",
        "angular-route": "1.8.3",
        "bootstrap": "4.6.2",
        "d3": "7.9.0",
        "moment": "2.31.0",
        "ngstorage": "0.3.11",
        "twix": "1.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.1",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1"
    }
}
