{
    "name": "del_stats_frontend",
    "version": "1.0.0",
    "description": "Public frontend for DEL hockey statistics. Contains a static AngularJS frontend for presenting player, team, and career data.",
    "private": true,
    "scripts": {
        "format": "prettier --write README.md CONTRIBUTING.md package.json pnpm-lock.yaml .prettierrc.json .github/workflows/ci.yml",
        "format:check": "prettier --check README.md CONTRIBUTING.md package.json pnpm-lock.yaml .prettierrc.json .github/workflows/ci.yml",
        "validate:routes": "node scripts/validate-routes.js",
        "check": "pnpm run format:check && pnpm run validate:routes"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leaffan/del_stats_frontend.git"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/leaffan/del_stats_frontend/issues"
    },
    "homepage": "https://github.com/leaffan/del_stats_frontend#readme",
    "devDependencies": {
        "prettier": "^3.8.4"
    }
}
